# ─────────────────────────────────────────────────────────────────────────────
# RSVP endpoint — Google Apps Script Web App URL
#
# Setup (see README.md § RSVP for screenshots-worth of detail):
#   1. Create a Google Sheet
#   2. Extensions → Apps Script, paste scripts/rsvp-apps-script.gs
#   3. Deploy → New deployment → Web app
#        Execute as:      Me
#        Who has access:  Anyone
#   4. Copy the /exec URL and paste it below
#
# Leave blank during development — the form still validates and shows its
# success state, it just logs to the console instead of writing to a Sheet.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RSVP_ENDPOINT=

# Canonical site URL, used for Open Graph / share-card absolute URLs.
NEXT_PUBLIC_SITE_URL=https://mahipal-niharika.vercel.app
